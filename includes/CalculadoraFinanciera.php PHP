class CalculadoraFinanciera {
    private float $montoBase;
    private float $tasaAnual;
    private int $plazoMeses;

    public function __construct(float $monto, float $tasa, int $plazo) {
        if ($monto <= 0 || $tasa <= 0 || $plazo <= 0) {
            throw new InvalidArgumentException('Todos los valores deben ser mayores a cero.');
        }
        $this->montoBase = $monto;
        $this->tasaAnual = $tasa;
        $this->plazoMeses = $plazo;
    }

    public function getMontoBase(): float {
        return $this->montoBase;
    }

    public function getTasaAnual(): float {
        return $this->tasaAnual;
    }

    public function getPlazoMeses(): int {
        return $this->plazoMeses;
    }

    public function calcularCuotaMensual(): float {
        $i = ($this->tasaAnual / 100) / 12; // interés mensual
        $n = $this->plazoMeses;

        if ($i == 0) {
            return $this->montoBase / $n;
        }

        $cuota = $this->montoBase * ($i * pow(1 + $i, $n)) / (pow(1 + $i, $n) - 1);
        return round($cuota, 2);
    }

    public function __call($name, $arguments) {
        if ($name === 'calcularInteresTotal') {
            $mesesExtra = isset($arguments[0]) ? (int)$arguments[0] : 0;
            $plazoTotal = $this->plazoMeses + $mesesExtra;

            // Crear una calculadora temporal con el nuevo plazo
            $temp = new self($this->montoBase, $this->tasaAnual, $plazoTotal);
            $cuota = $temp->calcularCuotaMensual();
            $interesTotal = ($cuota * $plazoTotal) - $this->montoBase;
            return round($interesTotal, 2);
        }

        throw new BadMethodCallException("Método $name no existe.");
    }
}Commit obligatorio
